---
interface Props {
	endpoint: string;
}
const { endpoint } = Astro.props;
const pageId = Astro.locals.starlightRoute.entry.id;
---

<ask-ai data-endpoint={endpoint} data-page={pageId} class="not-content">
	<button type="button" class="ask-fab" data-open aria-haspopup="dialog">
		<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 2 9.5 8.5 3 11l6.5 2.5L12 20l2.5-6.5L21 11l-6.5-2.5L12 2Z"></path></svg>
		Ask AI
	</button>
	<dialog class="ask-dialog" aria-labelledby="ask-ai-title">
		<header class="ask-header">
			<h2 id="ask-ai-title">Ask NG Guide AI</h2>
			<button type="button" class="ask-close" data-close aria-label="Close">✕</button>
		</header>
		<div class="ask-messages" data-messages aria-live="polite">
			<p class="ask-hint">
				Ask anything about Angular 22. Answers are generated from NG Guide content and may contain mistakes, so check the linked sources.
			</p>
		</div>
		<form class="ask-form" data-form>
			<textarea name="question" rows="2" maxlength="1000" required placeholder="e.g. How do I validate a Signal Form field asynchronously?"></textarea>
			<button type="submit" class="ask-send">Send</button>
		</form>
	</dialog>
</ask-ai>

<script>
	type Role = 'user' | 'assistant';
	interface Turn {
		role: Role;
		content: string;
	}
	interface Source {
		title: string;
		url: string;
	}

	const GUIDE_ORIGIN = 'https://ng-guide.letsprogram.in';

	function escapeHtml(text: string): string {
		return text.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
	}

	function guideHref(url: string): string | null {
		if (url.startsWith(GUIDE_ORIGIN)) return url.slice(GUIDE_ORIGIN.length) || '/';
		if (url.startsWith('/') && !url.startsWith('//')) return url;
		return /^https:\/\//.test(url) ? url : null;
	}

	function inline(text: string): string {
		return escapeHtml(text)
			.replace(/`([^`]+)`/g, '<code>$1</code>')
			.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
			.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_m, label: string, url: string) => {
				const href = guideHref(url.replace(/&amp;/g, '&'));
				return href ? `<a href="${escapeHtml(href)}">${label}</a>` : label;
			});
	}

	function renderProse(text: string): string {
		const blocks: string[] = [];
		for (const para of text.split(/\n{2,}/)) {
			const lines = para.split('\n').filter((l) => l.trim());
			if (!lines.length) continue;
			if (lines.every((l) => /^\s*[-*] /.test(l))) {
				blocks.push(`<ul>${lines.map((l) => `<li>${inline(l.replace(/^\s*[-*] /, ''))}</li>`).join('')}</ul>`);
			} else if (lines.every((l) => /^\s*\d+\. /.test(l))) {
				blocks.push(`<ol>${lines.map((l) => `<li>${inline(l.replace(/^\s*\d+\. /, ''))}</li>`).join('')}</ol>`);
			} else if (/^#{1,6} /.test(lines[0])) {
				blocks.push(`<p><strong>${inline(lines[0].replace(/^#{1,6} /, ''))}</strong></p>`);
				if (lines.length > 1) blocks.push(`<p>${lines.slice(1).map(inline).join('<br>')}</p>`);
			} else {
				blocks.push(`<p>${lines.map(inline).join('<br>')}</p>`);
			}
		}
		return blocks.join('');
	}

	/** Escape first, then allow only a small set of generated tags. Unclosed fences stay escaped code. */
	function renderMarkdown(markdown: string): string {
		const blocks: string[] = [];
		const fence = /```[\w-]*\n?([\s\S]*?)```/g;
		let last = 0;
		for (const match of markdown.matchAll(fence)) {
			const index = match.index ?? 0;
			blocks.push(renderProse(markdown.slice(last, index)));
			blocks.push(`<pre><code>${escapeHtml(match[1].replace(/\n$/, ''))}</code></pre>`);
			last = index + match[0].length;
		}
		const rest = markdown.slice(last);
		const unclosed = rest.indexOf('```');
		if (unclosed === -1) blocks.push(renderProse(rest));
		else {
			blocks.push(renderProse(rest.slice(0, unclosed)));
			blocks.push(`<pre><code>${escapeHtml(rest.slice(unclosed).replace(/^```[\w-]*\n?/, ''))}</code></pre>`);
		}
		return blocks.join('');
	}

	class AskAi extends HTMLElement {
		private history: Turn[] = [];
		private busy = false;

		connectedCallback() {
			const dialog = this.querySelector('dialog')!;
			const form = this.querySelector<HTMLFormElement>('[data-form]')!;
			const textarea = form.querySelector('textarea')!;
			this.querySelector('[data-open]')!.addEventListener('click', () => {
				dialog.showModal();
				textarea.focus();
			});
			this.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
			dialog.addEventListener('click', (event) => {
				if (event.target === dialog) dialog.close();
			});
			textarea.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' && !event.shiftKey) {
					event.preventDefault();
					form.requestSubmit();
				}
			});
			form.addEventListener('submit', (event) => {
				event.preventDefault();
				const question = textarea.value.trim();
				if (!question || this.busy) return;
				textarea.value = '';
				void this.ask(question);
			});
		}

		private addMessage(role: Role, html: string): HTMLElement {
			const messages = this.querySelector('[data-messages]')!;
			const el = document.createElement('div');
			el.className = `ask-msg ask-${role}`;
			el.innerHTML = html;
			messages.append(el);
			messages.scrollTop = messages.scrollHeight;
			return el;
		}

		private async ask(question: string) {
			this.busy = true;
			this.addMessage('user', `<p>${escapeHtml(question)}</p>`);
			const answerEl = this.addMessage('assistant', '<p class="ask-thinking">Thinking…</p>');
			const messages = this.querySelector('[data-messages]')!;
			let answer = '';
			let sources: Source[] = [];
			try {
				const response = await fetch(this.dataset.endpoint!, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ question, page: this.dataset.page, history: this.history.slice(-6) }),
				});
				if (!response.ok || !response.body) throw new Error(`HTTP ${response.status}`);
				const reader = response.body.pipeThrough(new TextDecoderStream()).getReader();
				let buffer = '';
				while (true) {
					const { value, done } = await reader.read();
					if (done) break;
					buffer += value;
					const lines = buffer.split('\n');
					buffer = lines.pop() ?? '';
					for (const line of lines) {
						if (!line.trim()) continue;
						const event = JSON.parse(line) as { type: string; text?: string; message?: string; sources?: Source[] };
						if (event.type === 'delta' && event.text) answer += event.text;
						if (event.type === 'sources' && event.sources) sources = event.sources;
						if (event.type === 'error') throw new Error(event.message ?? 'Unknown error');
					}
					answerEl.innerHTML = renderMarkdown(answer);
					messages.scrollTop = messages.scrollHeight;
				}
				const links = sources
					.flatMap((s) => {
						const href = guideHref(s.url);
						return href ? [`<li><a href="${escapeHtml(href)}">${escapeHtml(s.title)}</a></li>`] : [];
					})
					.join('');
				answerEl.innerHTML = renderMarkdown(answer) + (links ? `<p class="ask-sources-title">Sources</p><ul class="ask-sources">${links}</ul>` : '');
				this.history.push({ role: 'user', content: question }, { role: 'assistant', content: answer });
			} catch (error) {
				answerEl.innerHTML = `<p class="ask-error">Sorry, the AI assistant is unavailable right now (${escapeHtml(String((error as Error).message))}).</p>`;
			} finally {
				this.busy = false;
				messages.scrollTop = messages.scrollHeight;
			}
		}
	}

	if (!customElements.get('ask-ai')) customElements.define('ask-ai', AskAi);
</script>

<style>
	.ask-fab {
		position: fixed;
		z-index: 50;
		inset-block-end: 1.25rem;
		inset-inline-end: 1.25rem;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.65rem 1rem;
		border: 0;
		border-radius: 999px;
		background: var(--ng-gradient, var(--sl-color-accent));
		color: #fff;
		font-weight: 600;
		font-size: var(--sl-text-sm);
		box-shadow: 0 8px 24px hsla(330, 90%, 40%, 0.35);
		cursor: pointer;
	}
	.ask-fab:hover {
		filter: brightness(1.08);
	}
	.ask-dialog {
		width: min(42rem, calc(100vw - 2rem));
		height: min(80vh, 46rem);
		max-height: min(80vh, 46rem);
		padding: 0;
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-1);
		box-shadow: var(--sl-shadow-lg);
	}
	.ask-dialog[open] {
		display: flex;
		flex-direction: column;
	}
	.ask-dialog::backdrop {
		background: hsla(240, 16%, 4%, 0.6);
		backdrop-filter: blur(4px);
	}
	.ask-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}
	.ask-header h2 {
		margin: 0;
		font-size: var(--sl-text-lg);
	}
	.ask-close {
		border: 0;
		background: none;
		color: var(--sl-color-gray-3);
		font-size: 1.1rem;
		cursor: pointer;
	}
	.ask-messages {
		flex: 1;
		min-height: 0;
		overflow: auto;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-size: var(--sl-text-sm);
	}
	.ask-hint {
		margin: 0;
		color: var(--sl-color-gray-3);
	}
	.ask-msg {
		max-width: 92%;
		padding: 0.6rem 0.85rem;
		border-radius: 0.75rem;
		line-height: 1.55;
		overflow-wrap: anywhere;
	}
	.ask-msg :global(p) {
		margin: 0 0 0.5rem;
	}
	.ask-msg :global(p:last-child) {
		margin-bottom: 0;
	}
	.ask-msg :global(pre),
	.ask-msg pre {
		margin: 0.5rem 0;
		padding: 0.6rem;
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		overflow-x: auto;
		white-space: pre-wrap;
		font-size: var(--sl-text-xs);
	}
	.ask-user {
		align-self: flex-end;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	.ask-assistant {
		align-self: flex-start;
		background: var(--sl-color-gray-6);
	}
	.ask-msg :global(.ask-sources-title) {
		margin-top: 0.6rem;
		font-weight: 600;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.ask-msg :global(.ask-error) {
		color: var(--sl-color-red-high, #f87171);
	}
	.ask-msg :global(.ask-thinking) {
		color: var(--sl-color-gray-3);
	}
	.ask-form {
		display: flex;
		gap: 0.5rem;
		padding: 0.75rem;
		border-top: 1px solid var(--sl-color-gray-5);
	}
	.ask-form textarea {
		flex: 1;
		resize: none;
		padding: 0.55rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		font: inherit;
		font-size: var(--sl-text-sm);
	}
	.ask-send {
		padding: 0 1rem;
		border: 0;
		border-radius: 0.6rem;
		background: var(--sl-color-accent);
		color: #fff;
		font-weight: 600;
		cursor: pointer;
	}
</style>

<style is:global>
	/* Messages are created in JavaScript, so they do not receive Astro's scoped class. */
	ask-ai .ask-msg {
		max-width: 92%;
		padding: 0.6rem 0.85rem;
		border-radius: 0.75rem;
		line-height: 1.55;
		overflow-wrap: anywhere;
	}
	ask-ai .ask-msg p {
		margin: 0 0 0.5rem;
	}
	ask-ai .ask-msg p:last-child {
		margin-bottom: 0;
	}
	ask-ai .ask-msg pre {
		margin: 0.5rem 0;
		padding: 0.75rem;
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		overflow-x: auto;
		white-space: pre-wrap;
		font-size: var(--sl-text-xs);
	}
	ask-ai .ask-msg code {
		font-family: var(--sl-font-mono);
	}
	ask-ai .ask-user {
		align-self: flex-end;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	ask-ai .ask-assistant {
		align-self: flex-start;
		background: var(--sl-color-gray-6);
	}
	ask-ai .ask-sources-title {
		margin-top: 0.6rem;
		font-weight: 600;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	ask-ai .ask-error {
		color: var(--sl-color-red-high, #f87171);
	}
</style>
